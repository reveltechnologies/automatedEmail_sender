# Copy this file to .env and fill it in. .env is git-ignored - never commit it.

# Who the emails come from
SENDER_EMAIL=team@example.com
SENDER_NAME=Example App Team
# Optional: where replies go (defaults to SENDER_EMAIL)
REPLY_TO=
# Where unsubscribe requests go (defaults to SENDER_EMAIL)
UNSUBSCRIBE_EMAIL=

# SMTP server. Examples:
#   Gmail / Google Workspace: smtp.gmail.com, port 587, starttls (needs an App Password)
#   Outlook / Microsoft 365:  smtp.office365.com, port 587, starttls
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# starttls (port 587) or ssl (port 465). Unencrypted connections are not supported.
SMTP_SECURITY=starttls
SMTP_USERNAME=team@example.com
SMTP_PASSWORD=
